# Copy to ".env" and fill in your values.

# Where OpenWA is running:
OPENWA_URL=http://localhost:2785

# Your OpenWA API key (printed in `docker logs openwa-api` on first boot).
OPENWA_API_KEY=your-openwa-api-key-here

# Default account/session name:
SESSION_ID=test1

# Port WaSender listens on:
PORT=3000

# URL OpenWA (in Docker) uses to reach WaSender for incoming-message webhooks.
WEBHOOK_URL=http://host.docker.internal:3000/webhook

# Optional: require a login to open the dashboard. Leave empty for no login (local use).
APP_PASSWORD=
